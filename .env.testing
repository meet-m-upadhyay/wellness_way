# WellnessWay Diet Planner - Testing Environment Configuration
# This file contains testing-specific settings

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
ENVIRONMENT=development
DEBUG=true
TESTING=true

# =============================================================================
# DATABASE CONFIGURATION (Testing)
# =============================================================================
DATABASE_URL=postgresql://test:test@localhost:5432/test_wellnessway_db
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# Test database settings
POSTGRES_USER=test
POSTGRES_PASSWORD=test
POSTGRES_DB=test_wellnessway_db

# =============================================================================
# SECURITY CONFIGURATION (Testing)
# =============================================================================
SECRET_KEY=test-secret-key-not-for-production
BCRYPT_ROUNDS=4
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Permissive CORS for testing
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# No rate limiting in tests
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# =============================================================================
# AI INTEGRATION (Testing)
# =============================================================================
# Disable AI in tests by default
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TIMEOUT=5
OPENAI_MAX_RETRIES=1

# Fast AI settings for tests
MAX_PLAN_GENERATION_TIME=10
ENABLE_CONTENT_FILTERING=false

# =============================================================================
# CACHE CONFIGURATION (Testing)
# =============================================================================
REDIS_URL=redis://localhost:6379/1
REDIS_MAX_CONNECTIONS=5
REDIS_TIMEOUT=2

# Short cache TTL for tests
USER_PROFILE_TTL=60
DIET_PLAN_TTL=120
HEALTH_CONTEXT_TTL=60

# =============================================================================
# LOGGING CONFIGURATION (Testing)
# =============================================================================
LOG_LEVEL=DEBUG
LOG_FORMAT=text
ENABLE_FILE_LOGGING=false

# Minimal logging for tests
INCLUDE_REQUEST_ID=false
INCLUDE_USER_ID=false
MASK_SENSITIVE_DATA=false

# =============================================================================
# MONITORING (Testing)
# =============================================================================
# Disable monitoring in tests
SENTRY_DSN=
SENTRY_ENVIRONMENT=testing
SENTRY_SAMPLE_RATE=0.0

ENABLE_HEALTH_CHECKS=false
ENABLE_METRICS=false

# =============================================================================
# FEATURE FLAGS (Testing)
# =============================================================================
ENABLE_USER_REGISTRATION=true
ENABLE_AI_GENERATION=false
ENABLE_PLAN_REGENERATION=true
ENABLE_ANALYTICS=false

# =============================================================================
# FRONTEND CONFIGURATION (Testing)
# =============================================================================
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENVIRONMENT=testing

# =============================================================================
# TESTING NOTES
# =============================================================================
# 1. Uses separate test database to avoid conflicts
# 2. Faster settings for quicker test execution
# 3. Disabled external services (AI, monitoring)
# 4. Minimal logging to reduce test noise
# 5. Permissive security settings for easier testing