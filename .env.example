# WellnessWay Diet Planner - Environment Configuration Template
# Copy this file to .env and update the values for your environment

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
ENVIRONMENT=development
DEBUG=true
TESTING=false

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://wellnessway:password@localhost:5432/wellnessway_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# PostgreSQL specific (for Docker Compose)
POSTGRES_USER=wellnessway
POSTGRES_PASSWORD=password
POSTGRES_DB=wellnessway_db

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# IMPORTANT: Generate secure keys! Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
# For development, you can use dummy values, but change them in production
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# AI INTEGRATION
# =============================================================================
# Choose your AI Provider: openai, groq, huggingface, ollama, or mock
AI_PROVIDER=groq

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Groq Configuration (Free alternative - 14,400 requests/day)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# HuggingFace Configuration
# Get your API key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=microsoft/DialoGPT-large

# Ollama Configuration (Local - completely free)
# Run locally: https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_MAX_TOKENS=400
OPENAI_TEMPERATURE=0.4
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

# AI Safety Settings
MAX_PLAN_GENERATION_TIME=30
ENABLE_CONTENT_FILTERING=true

# =============================================================================
# CACHE CONFIGURATION (Redis)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=5
REDIS_MAX_CONNECTIONS=10

# Cache TTL Settings (in seconds)
USER_PROFILE_TTL=3600
DIET_PLAN_TTL=86400
HEALTH_CONTEXT_TTL=7200

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_FILE_LOGGING=true
LOG_FILE_PATH=logs/app.log
MAX_FILE_SIZE_MB=10
BACKUP_COUNT=5

# Structured Logging
INCLUDE_REQUEST_ID=true
INCLUDE_USER_ID=true
MASK_SENSITIVE_DATA=true

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================
# Sentry Configuration (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_SAMPLE_RATE=1.0

# Health Checks
ENABLE_HEALTH_CHECKS=true
HEALTH_CHECK_TIMEOUT=5

# Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_USER_REGISTRATION=true
ENABLE_AI_GENERATION=true
ENABLE_PLAN_REGENERATION=true
ENABLE_ANALYTICS=false

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Backend API endpoint
REACT_APP_API_URL=http://localhost:8000/api/v1
REACT_APP_ENVIRONMENT=development

# Google OAuth Configuration (Frontend)
# Get your Client ID from: https://console.cloud.google.com/
# See GOOGLE_OAUTH_SETUP.md for detailed setup instructions
REACT_APP_GOOGLE_CLIENT_ID=

# =============================================================================
# GOOGLE OAUTH (BACKEND)
# =============================================================================
# Backend configuration for Google OAuth
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# SECRETS MANAGEMENT
# =============================================================================
# Encryption key for local secrets (development only)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRETS_ENCRYPTION_KEY=

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Enable SQL query logging in development
SQL_ECHO=false

# Enable debug toolbar
ENABLE_DEBUG_TOOLBAR=false

# =============================================================================
# PRODUCTION NOTES
# =============================================================================
# For production deployment:
# 1. Set ENVIRONMENT=production
# 2. Set DEBUG=false
# 3. Generate a secure SECRET_KEY
# 4. Set proper OPENAI_API_KEY
# 5. Configure production database URL
# 6. Set up proper CORS_ORIGINS
# 7. Configure Sentry DSN for error tracking
# 8. Set up proper Redis URL for caching
# 9. Configure proper logging paths
# 10. Set SECRETS_ENCRYPTION_KEY to a secure value