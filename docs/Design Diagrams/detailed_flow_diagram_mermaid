flowchart TD
    %% Base Start
    Start(("User Request"))
    
    %% API Endpoints
    subgraph FastAPI ["FastAPI Flow (diet_plans_ml.py)"]
        API_Daily("generate_daily_plan_ml(request, db, current_user_id)")
        API_Parse("parse_daily_request(request)")
        API_HCD["DB Query: HealthContextDocument(is_active=True)"]
        API_Init("get_ml_pipeline_orchestrator(db)")
    end

    %% ML Orchestrator Core 
    subgraph Orch ["ML Orchestrator (orchestrator.py)"]
        Orch_Exec("orchestrator.generate_daily_plan(db, user_id, context, date)")
        Orch_Ext("_extract_constraints(health_context)")
        
        %% Step 1
        Orch_Step1("STEP 1: Portfolio Discovery")
        
        %% Step 2
        Orch_Step2("STEP 2: Assembly")
        
        %% Step 3
        Orch_Step3("STEP 3: Creative Generation (Loop)")
        
        %% Step 4 & 5
        Orch_Step4("STEP 4: Plan Validation")
        Orch_Step5("STEP 5: Nutrition Calculation")
    end

    %% Engines
    subgraph Disc ["Discovery Engine"]
        Disc_Call("discover_daily_portfolio(diet_type, allergies)")
        Disc_FAISS["Embeddings Generator + FAISS Vector Index"]
        Disc_DB["PostgreSQL Query: FoodItem(is_deprecated=False)"]
        Disc_Fallback["Fallback heuristic logic (Exclude keywords)"]
        Disc_Random["Random categorical sampling (Protein, Starch, Veggie, Fat)"]
    end

    subgraph Assem ["Daily Assembler"]
        Assem_Call("assemble_day(portfolio, \ntarget_calories, target_protein)")
        Assem_Math["Linear Distribution Math\n(Calculating precise ingredient masses in grams)"]
    end

    subgraph Validation ["Validation & Nutrition"]
        Val_Call("validate_daily_plan(meals)")
        Nut_Call("calculate_daily_nutrition(final_meals)")
    end

    %% GenAI Services & LLM Target
    subgraph LLM ["AI Text Generation (genai/service.py)"]
        GenAI_Call("genai.generate_meal_text(\ningredients_list, meal_type, diet_type)")
        
        GroqGen("get_groq_generator()")
        
        Prompt[/"<b>Prompt Sent to Model (Groq or OpenAI):</b><br>Generate a creative recipe name, description, and instructions<br>for a {meal_type} with these ingredients:<br>{ingredients_json}<br>The user follows a {diet_type} diet.<br><i>Keep instructions short and clear.</i>"/]
        
        Schema[/"<b>Enforced JSON Schema:</b><br>{<br>'meal_name': str,<br>'description': str,<br>'prep_time_minutes': int,<br>'cook_time_minutes': int,<br>'servings': int,<br>'steps': list[str]<br>}"/]
        
        GenAI_Fallback{"Did LLM Fail<br>or break Schema?"}
        GenAI_Dict["Return Pydantic GenAIMealText Dict"]
        GenAI_Safe["Return Safe Fallback Dict"]
    end

    %% Final
    subgraph EndDB ["Database Save"]
        DB_Save("DietPlan(content=plan_data)")
        DB_Commit("db.commit() & db.refresh()")
        Response("DietPlanResponse.model_validate()")
    end

    %% Flow Mapping 
    Start --> API_Daily
    API_Daily --> API_Parse
    API_Parse --> API_HCD
    API_HCD --> API_Init
    API_Init --> Orch_Exec
    
    Orch_Exec --> Orch_Ext
    Orch_Ext --> Orch_Step1
    
    Orch_Step1 --> Disc_Call
    Disc_Call --> Disc_DB
    Disc_Call --> Disc_FAISS
    Disc_DB --> Disc_Fallback
    Disc_Fallback --> Disc_Random
    Disc_Random -->|Returns 4x lists of 3 FoodItems| Orch_Step2
    
    Orch_Step2 --> Assem_Call
    Assem_Call --> Assem_Math
    Assem_Math -->|Returns list of raw_meals Dicts| Orch_Step3
    
    Orch_Step3 --> GenAI_Call
    GenAI_Call --> GroqGen
    GroqGen --> Prompt
    Prompt --> Schema
    Schema --> GenAI_Fallback
    GenAI_Fallback -->|Valid| GenAI_Dict
    GenAI_Fallback -->|Invalid/Error| GenAI_Safe
    
    GenAI_Dict --> Orch_Step4
    GenAI_Safe --> Orch_Step4
    
    Orch_Step4 --> Val_Call
    Val_Call -->|Returns validation_result.warnings| Orch_Step5
    
    Orch_Step5 --> Nut_Call
    Nut_Call -->|Returns mapped Daily Totals dict| DB_Save
    
    DB_Save --> DB_Commit
    DB_Commit --> Response
    
    %% Colors 
    classDef mainFlow fill:#dae8fc,stroke:#6c8ebf,color:#000
    classDef llmFlow fill:#e1d5e7,stroke:#9673a6,color:#000
    classDef internal fill:#fff2cc,stroke:#d6b656,color:#000
    classDef promptbox fill:#f5f5f5,stroke:#666666,color:#000,stroke-dasharray: 5 5

    class Start,API_Daily,Orch_Exec,DB_Save,Response mainFlow
    class GenAI_Call,GroqGen,GenAI_Fallback llmFlow
    class Prompt,Schema promptbox
    class Disc_Call,Assem_Call,Val_Call,Nut_Call internal
    
    Notes --> BottomNote["`
    Based on the architecture and codebase of the WellnessWay application, here are the ML and AI models used during the Daily Meal Plan Generation flow, along with their steps and responsibilities:

    1. Vector Embeddings & Similarity Search
    Model: all-MiniLM-L6-v2 (via sentence-transformers) coupled with a FAISS Vector Index.
    Location: app/services/ml_diet_pipeline/embeddings/generator.py and canonicalization services.
    Step Called: Referenced in Step 1: Portfolio Discovery (as per your detailed architecture diagram).
    Responsibility: The EmbeddingGenerator generates dense vector representations of food items. The FAISS index is used by the IngredientCanonicalizer to map raw user ingredient requests or dynamically discovered food items to canonical database entries. (Note: The current active discovery_engine.py primarily uses PostgreSQL heuristics and random categorical sampling, but the canonicalization pipeline is initialized as part of the core ML orchestrator to support similarity search).
    2. Generative AI (LLM) for Recipe Creation
    Model: Defaults to llama-3.1-8b-instant over the Groq API (Configurable in app/core/config.py to also use gpt-4 via OpenAI, meta-llama/Llama-3.2-1B-Instruct via HuggingFace, or a local llama3.1 via Ollama).
    Location: app/services/ml_diet_pipeline/genai/service.py (GenAIService) and app/services/ml_diet_pipeline/orchestrator.py (get_groq_generator).
    Step Called:
    Step 3: Creative Generation (Loop): Called for each assembled meal.
    Daily Summary Generation: Called once after validation.
    Responsibility:
    Recipe Generation: It takes the raw, calculated list of ingredients and precise gram weights from the DailyAssembler and generates a creative meal_name, description, and step-by-step cooking instructions. It is strictly prompted to return a precise JSON schema (GenAIMealText).
    Fallback Handling: If the LLM breaks schema or times out, the GenAIService intercepts the failure and yields a safe, hardcoded placeholder dict to prevent the pipeline from crashing.
    Daily Plan Text: Generates a quick conversational summary string and motivational notes summarizing the final daily macros of the created plan.
        `"]
