# WellnessWay Diet Planner - Supabase Cloud Database Configuration
# 
# This template is for Supabase cloud PostgreSQL database setup.
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.supabase.example .env.supabase
# 2. Get your Supabase credentials from https://supabase.com/dashboard
# 3. Navigate to Settings → Database to find your connection details
# 4. Replace the placeholder values below with your actual credentials
# 5. Copy to .env for local development: cp .env.supabase .env
# 
# SECURITY:
# - NEVER commit .env or .env.supabase to git
# - These files contain sensitive database credentials
# - Keep backups of your credentials in a secure location
# - Use strong, unique passwords
#

# =============================================================================
# SUPABASE DATABASE CONFIGURATION (REQUIRED)
# =============================================================================
# Format: postgresql+psycopg://user:password@host:port/database
# Example: postgresql+psycopg://postgres:MyPassword123@db.abcdef123456.supabase.co:5432/postgres
# 
# To find your credentials:
# 1. Go to supabase.com/dashboard
# 2. Select your project
# 3. Click "Settings" → "Database"
# 4. Find "Connection string" section
# 5. Copy the values and replace placeholders below
#
DATABASE_URL=postgresql+psycopg://postgres:[YOUR_PASSWORD]@db.[YOUR_PROJECT_REF].supabase.co:5432/postgres

# Database Connection Pool Configuration
# These settings optimize connection management for cloud database
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# =============================================================================
# SUPABASE API CONFIGURATION (OPTIONAL - for frontend integration)
# =============================================================================
# Find these at: https://app.supabase.com/project/YOUR_PROJECT_REF/settings/api
# 
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=[YOUR_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SERVICE_ROLE_KEY]

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
ENVIRONMENT=development
DEBUG=true
TESTING=false

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# IMPORTANT: Generate secure keys! Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
# For development, you can use dummy values, but change them in production
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log
LOG_FORMAT=json

# =============================================================================
# AI INTEGRATION (OpenAI)
# =============================================================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=wellnessway@example.com
SMTP_FROM_NAME=WellnessWay

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_URL=http://localhost:3000
FRONTEND_BUILD_DIR=../frontend/dist

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_AI_ENABLED=true
FEATURE_MEAL_RECOMMENDATIONS=true
FEATURE_NUTRITIONAL_TRACKING=true
FEATURE_USER_PREFERENCES=true
FEATURE_ADMIN_PANEL=true

# =============================================================================
# SUPABASE-SPECIFIC SETTINGS
# =============================================================================
# Enable SSL for cloud connection (recommended)
DATABASE_SSL_MODE=require

# Connection timeout (seconds)
DATABASE_CONNECT_TIMEOUT=10

# Idle connection timeout (seconds)
DATABASE_IDLE_TIMEOUT=300

# =============================================================================
# MONITORING AND ANALYTICS (Optional)
# =============================================================================
SENTRY_DSN=
MONITORING_ENABLED=false

# =============================================================================
# NOTES
# =============================================================================
# 
# After setting up this file:
# 1. Copy to .env: cp .env.supabase .env
# 2. Test connection: python setup_supabase.py --test-connection
# 3. Run migrations: python -m alembic upgrade head
# 4. Start backend: python start_backend.py
# 
# For troubleshooting, see: docs/SUPABASE_MIGRATION.md
#
